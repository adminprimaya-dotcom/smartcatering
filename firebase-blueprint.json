{
  "entities": {
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Trusted administrator registry document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and RBAC role assignment.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "role": { "type": "string", "minLength": 1, "maxLength": 50 },
        "department": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "displayName", "email", "role", "department", "status", "createdAt", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Commercial catering product and menu package.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 400 },
        "sellingPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "estimatedProfit": { "type": "number" },
        "available": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "category", "packageName", "description", "imageUrl", "sellingPrice", "costPrice", "estimatedProfit", "available", "createdAt", "updatedAt"]
    },
    "CateringOrder": {
      "title": "CateringOrder",
      "description": "Commercial catering customer order.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 3, "maxLength": 40 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "whatsapp": { "type": "string", "minLength": 5, "maxLength": 30 },
        "orderDate": { "type": "string", "minLength": 8, "maxLength": 25 },
        "deliveryDate": { "type": "string", "minLength": 8, "maxLength": 25 },
        "eventType": { "type": "string", "minLength": 1, "maxLength": 60 },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "portions": { "type": "number" },
        "unitPrice": { "type": "number" },
        "discount": { "type": "number" },
        "totalPayment": { "type": "number" },
        "downPayment": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Belum Bayar", "DP Masuk", "Lunas"], "maxLength": 30 },
        "status": { "type": "string", "enum": ["Pesanan baru", "Menunggu pembayaran", "Diproses", "Sedang diproduksi", "Siap dikirim", "Dalam pengiriman", "Selesai", "Dibatalkan"], "maxLength": 40 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "orderNumber", "customerName", "whatsapp", "orderDate", "deliveryDate", "eventType", "packageName", "portions", "unitPrice", "discount", "totalPayment", "downPayment", "remainingBalance", "paymentStatus", "status", "notes", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Catering customer profile and transaction summary.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "locationLat": { "type": "number" },
        "locationLng": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "transactionCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isPriority": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "address", "phone", "locationLat", "locationLng", "totalPurchases", "transactionCount", "isActive", "isPriority", "createdAt", "updatedAt"]
    },
    "ProductionBatch": {
      "title": "ProductionBatch",
      "description": "Kitchen food production schedule and recipe calculation.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productionDate": { "type": "string", "minLength": 8, "maxLength": 25 },
        "menuName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "targetChannel": { "type": "string", "enum": ["Catering Komersial", "Sekolah Rakyat"], "maxLength": 40 },
        "portions": { "type": "number" },
        "recipeSummary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "rawMaterialNeed": { "type": "string", "minLength": 1, "maxLength": 400 },
        "productionCost": { "type": "number" },
        "officerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "type": "string", "enum": ["Terjadwal", "Persiapan Bahan", "Sedang Dimasak", "Quality Control", "Selesai", "Dibatalkan"], "maxLength": 40 },
        "documentationNote": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "productionDate", "menuName", "targetChannel", "portions", "recipeSummary", "rawMaterialNeed", "productionCost", "officerName", "status", "documentationNote", "createdAt", "updatedAt"]
    },
    "SchoolRecord": {
      "title": "SchoolRecord",
      "description": "Sekolah Rakyat partner school data with GPS coordinates.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "npsn": { "type": "string", "minLength": 4, "maxLength": 25 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 },
        "principalName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "contactPhone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "studentCount": { "type": "number" },
        "classCount": { "type": "number" },
        "deliverySchedule": { "type": "string", "minLength": 1, "maxLength": 120 },
        "partnershipStatus": { "type": "string", "enum": ["Aktif", "Evaluasi", "Nonaktif"], "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "schoolName", "npsn", "address", "principalName", "contactPhone", "lat", "lng", "studentCount", "classCount", "deliverySchedule", "partnershipStatus", "createdAt", "updatedAt"]
    },
    "SchoolDelivery": {
      "title": "SchoolDelivery",
      "description": "Daily meal distribution record for Sekolah Rakyat.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deliveryDate": { "type": "string", "minLength": 8, "maxLength": 25 },
        "schoolId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "menuPackage": { "type": "string", "minLength": 1, "maxLength": 150 },
        "portionsDelivered": { "type": "number" },
        "courierName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "departureTime": { "type": "string", "minLength": 3, "maxLength": 20 },
        "arrivalTime": { "type": "string", "minLength": 1, "maxLength": 20 },
        "recipientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["Persiapan", "Dalam Pengiriman", "Selesai", "Dibatalkan"], "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deliveryDate", "schoolId", "schoolName", "menuPackage", "portionsDelivered", "courierName", "departureTime", "arrivalTime", "recipientName", "status", "createdAt", "updatedAt"]
    },
    "FinanceEntry": {
      "title": "FinanceEntry",
      "description": "Financial ledger entry for income, expense, debt, and receivable.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transactionDate": { "type": "string", "minLength": 8, "maxLength": 25 },
        "referenceCode": { "type": "string", "minLength": 3, "maxLength": 40 },
        "type": { "type": "string", "enum": ["Pendapatan Catering", "Pendapatan Sekolah Rakyat", "Pengeluaran Operasional", "Utang Supplier", "Piutang Pelanggan"], "maxLength": 40 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "amount": { "type": "number" },
        "accountMethod": { "type": "string", "enum": ["Kas Tunai", "Bank Mandiri ERP", "Bank BRI Sekolah Rakyat", "Bank BCA Corporate"], "maxLength": 50 },
        "settlementStatus": { "type": "string", "enum": ["Lunas", "Belum Lunas"], "maxLength": 25 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "transactionDate", "referenceCode", "type", "category", "description", "amount", "accountMethod", "settlementStatus", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Food raw material stock and procurement item.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemCode": { "type": "string", "minLength": 2, "maxLength": 30 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "stockQty": { "type": "number" },
        "minStock": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
        "unitCost": { "type": "number" },
        "supplierName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "lastRestockDate": { "type": "string", "minLength": 8, "maxLength": 25 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "itemCode", "name", "category", "stockQty", "minStock", "unit", "unitCost", "supplierName", "lastRestockDate", "createdAt", "updatedAt"]
    },
    "PromotionItem": {
      "title": "PromotionItem",
      "description": "Marketing promotion and discount campaign.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "promoCode": { "type": "string", "minLength": 3, "maxLength": 30 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "targetSegment": { "type": "string", "minLength": 1, "maxLength": 80 },
        "discountPercent": { "type": "number" },
        "maxDiscountAmount": { "type": "number" },
        "validUntil": { "type": "string", "minLength": 8, "maxLength": 25 },
        "active": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "promoCode", "title", "targetSegment", "discountPercent", "maxDiscountAmount", "validUntil", "active", "usageCount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminDoc" },
      "description": "Trusted administrator lookup collection."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and RBAC role assignments isolated per user."
    },
    "/menu_items/{menuId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Catering products and menu items."
    },
    "/catering_orders/{orderId}": {
      "schema": { "$ref": "#/entities/CateringOrder" },
      "description": "Commercial catering orders."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer database records."
    },
    "/production_batches/{batchId}": {
      "schema": { "$ref": "#/entities/ProductionBatch" },
      "description": "Kitchen food production batches."
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/SchoolRecord" },
      "description": "Partner Sekolah Rakyat schools and GPS locations."
    },
    "/school_deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/SchoolDelivery" },
      "description": "Daily school meal delivery logs."
    },
    "/finance_entries/{entryId}": {
      "schema": { "$ref": "#/entities/FinanceEntry" },
      "description": "Accounting and cashflow ledger entries."
    },
    "/inventory_items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Raw material warehouse inventory items."
    },
    "/promotions/{promoId}": {
      "schema": { "$ref": "#/entities/PromotionItem" },
      "description": "Marketing promotions and voucher codes."
    }
  }
}
