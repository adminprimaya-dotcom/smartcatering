rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'primayaadmin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'email', 'role', 'department', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'displayName', 'email', 'role', 'department', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 50 &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
        data.status is string && data.status.size() <= 20 && data.status in ['Aktif', 'Nonaktif'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['ownerId', 'name', 'category', 'packageName', 'description', 'imageUrl', 'sellingPrice', 'costPrice', 'estimatedProfit', 'available', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'category', 'packageName', 'description', 'imageUrl', 'sellingPrice', 'costPrice', 'estimatedProfit', 'available', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 100 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 400 &&
        data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= 1000000000 &&
        data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 1000000000 &&
        data.estimatedProfit is number && data.estimatedProfit >= -1000000000 && data.estimatedProfit <= 1000000000 &&
        data.available is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCateringOrder(data) {
      return data.keys().hasAll(['ownerId', 'orderNumber', 'customerName', 'whatsapp', 'orderDate', 'deliveryDate', 'eventType', 'packageName', 'portions', 'unitPrice', 'discount', 'totalPayment', 'downPayment', 'remainingBalance', 'paymentStatus', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'orderNumber', 'customerName', 'whatsapp', 'orderDate', 'deliveryDate', 'eventType', 'packageName', 'portions', 'unitPrice', 'discount', 'totalPayment', 'downPayment', 'remainingBalance', 'paymentStatus', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.whatsapp is string && data.whatsapp.size() >= 5 && data.whatsapp.size() <= 30 &&
        data.orderDate is string && data.orderDate.size() >= 8 && data.orderDate.size() <= 25 &&
        data.deliveryDate is string && data.deliveryDate.size() >= 8 && data.deliveryDate.size() <= 25 &&
        data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 60 &&
        data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 120 &&
        data.portions is number && data.portions >= 1 && data.portions <= 100000 &&
        data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 100000000 &&
        data.discount is number && data.discount >= 0 && data.discount <= 1000000000 &&
        data.totalPayment is number && data.totalPayment >= 0 && data.totalPayment <= 10000000000 &&
        data.downPayment is number && data.downPayment >= 0 && data.downPayment <= 10000000000 &&
        data.remainingBalance is number && data.remainingBalance >= 0 && data.remainingBalance <= 10000000000 &&
        data.paymentStatus is string && data.paymentStatus.size() <= 30 && data.paymentStatus in ['Belum Bayar', 'DP Masuk', 'Lunas'] &&
        data.status is string && data.status.size() <= 40 && data.status in ['Pesanan baru', 'Menunggu pembayaran', 'Diproses', 'Sedang diproduksi', 'Siap dikirim', 'Dalam pengiriman', 'Selesai', 'Dibatalkan'] &&
        data.notes is string && data.notes.size() <= 400 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['ownerId', 'name', 'address', 'phone', 'locationLat', 'locationLng', 'totalPurchases', 'transactionCount', 'isActive', 'isPriority', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'address', 'phone', 'locationLat', 'locationLng', 'totalPurchases', 'transactionCount', 'isActive', 'isPriority', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.locationLat is number && data.locationLat >= -90 && data.locationLat <= 90 &&
        data.locationLng is number && data.locationLng >= -180 && data.locationLng <= 180 &&
        data.totalPurchases is number && data.totalPurchases >= 0 && data.totalPurchases <= 100000000000 &&
        data.transactionCount is number && data.transactionCount >= 0 && data.transactionCount <= 100000 &&
        data.isActive is bool &&
        data.isPriority is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductionBatch(data) {
      return data.keys().hasAll(['ownerId', 'productionDate', 'menuName', 'targetChannel', 'portions', 'recipeSummary', 'rawMaterialNeed', 'productionCost', 'officerName', 'status', 'documentationNote', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'productionDate', 'menuName', 'targetChannel', 'portions', 'recipeSummary', 'rawMaterialNeed', 'productionCost', 'officerName', 'status', 'documentationNote', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.productionDate is string && data.productionDate.size() >= 8 && data.productionDate.size() <= 25 &&
        data.menuName is string && data.menuName.size() >= 1 && data.menuName.size() <= 120 &&
        data.targetChannel is string && data.targetChannel.size() <= 40 && data.targetChannel in ['Catering Komersial', 'Sekolah Rakyat'] &&
        data.portions is number && data.portions >= 1 && data.portions <= 100000 &&
        data.recipeSummary is string && data.recipeSummary.size() >= 1 && data.recipeSummary.size() <= 400 &&
        data.rawMaterialNeed is string && data.rawMaterialNeed.size() >= 1 && data.rawMaterialNeed.size() <= 400 &&
        data.productionCost is number && data.productionCost >= 0 && data.productionCost <= 10000000000 &&
        data.officerName is string && data.officerName.size() >= 1 && data.officerName.size() <= 100 &&
        data.status is string && data.status.size() <= 40 && data.status in ['Terjadwal', 'Persiapan Bahan', 'Sedang Dimasak', 'Quality Control', 'Selesai', 'Dibatalkan'] &&
        data.documentationNote is string && data.documentationNote.size() >= 1 && data.documentationNote.size() <= 300 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSchoolRecord(data) {
      return data.keys().hasAll(['ownerId', 'schoolName', 'npsn', 'address', 'principalName', 'contactPhone', 'lat', 'lng', 'studentCount', 'classCount', 'deliverySchedule', 'partnershipStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'schoolName', 'npsn', 'address', 'principalName', 'contactPhone', 'lat', 'lng', 'studentCount', 'classCount', 'deliverySchedule', 'partnershipStatus', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 150 &&
        data.npsn is string && data.npsn.size() >= 4 && data.npsn.size() <= 25 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.principalName is string && data.principalName.size() >= 1 && data.principalName.size() <= 120 &&
        data.contactPhone is string && data.contactPhone.size() >= 5 && data.contactPhone.size() <= 30 &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lng is number && data.lng >= -180 && data.lng <= 180 &&
        data.studentCount is number && data.studentCount >= 1 && data.studentCount <= 50000 &&
        data.classCount is number && data.classCount >= 1 && data.classCount <= 1000 &&
        data.deliverySchedule is string && data.deliverySchedule.size() >= 1 && data.deliverySchedule.size() <= 120 &&
        data.partnershipStatus is string && data.partnershipStatus.size() <= 30 && data.partnershipStatus in ['Aktif', 'Evaluasi', 'Nonaktif'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSchoolDelivery(data) {
      return data.keys().hasAll(['ownerId', 'deliveryDate', 'schoolId', 'schoolName', 'menuPackage', 'portionsDelivered', 'courierName', 'departureTime', 'arrivalTime', 'recipientName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'deliveryDate', 'schoolId', 'schoolName', 'menuPackage', 'portionsDelivered', 'courierName', 'departureTime', 'arrivalTime', 'recipientName', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.deliveryDate is string && data.deliveryDate.size() >= 8 && data.deliveryDate.size() <= 25 &&
        isValidId(data.schoolId) &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 150 &&
        data.menuPackage is string && data.menuPackage.size() >= 1 && data.menuPackage.size() <= 150 &&
        data.portionsDelivered is number && data.portionsDelivered >= 1 && data.portionsDelivered <= 50000 &&
        data.courierName is string && data.courierName.size() >= 1 && data.courierName.size() <= 100 &&
        data.departureTime is string && data.departureTime.size() >= 3 && data.departureTime.size() <= 20 &&
        data.arrivalTime is string && data.arrivalTime.size() >= 1 && data.arrivalTime.size() <= 20 &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 120 &&
        data.status is string && data.status.size() <= 40 && data.status in ['Persiapan', 'Dalam Pengiriman', 'Selesai', 'Dibatalkan'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFinanceEntry(data) {
      return data.keys().hasAll(['ownerId', 'transactionDate', 'referenceCode', 'type', 'category', 'description', 'amount', 'accountMethod', 'settlementStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'transactionDate', 'referenceCode', 'type', 'category', 'description', 'amount', 'accountMethod', 'settlementStatus', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.transactionDate is string && data.transactionDate.size() >= 8 && data.transactionDate.size() <= 25 &&
        data.referenceCode is string && data.referenceCode.size() >= 3 && data.referenceCode.size() <= 40 &&
        data.type is string && data.type.size() <= 40 && data.type in ['Pendapatan Catering', 'Pendapatan Sekolah Rakyat', 'Pengeluaran Operasional', 'Utang Supplier', 'Piutang Pelanggan'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
        data.amount is number && data.amount >= 0 && data.amount <= 100000000000 &&
        data.accountMethod is string && data.accountMethod.size() <= 50 && data.accountMethod in ['Kas Tunai', 'Bank Mandiri ERP', 'Bank BRI Sekolah Rakyat', 'Bank BCA Corporate'] &&
        data.settlementStatus is string && data.settlementStatus.size() <= 25 && data.settlementStatus in ['Lunas', 'Belum Lunas'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['ownerId', 'itemCode', 'name', 'category', 'stockQty', 'minStock', 'unit', 'unitCost', 'supplierName', 'lastRestockDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'itemCode', 'name', 'category', 'stockQty', 'minStock', 'unit', 'unitCost', 'supplierName', 'lastRestockDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.itemCode is string && data.itemCode.size() >= 2 && data.itemCode.size() <= 30 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.stockQty is number && data.stockQty >= 0 && data.stockQty <= 1000000 &&
        data.minStock is number && data.minStock >= 0 && data.minStock <= 1000000 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
        data.unitCost is number && data.unitCost >= 0 && data.unitCost <= 100000000 &&
        data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 120 &&
        data.lastRestockDate is string && data.lastRestockDate.size() >= 8 && data.lastRestockDate.size() <= 25 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPromotionItem(data) {
      return data.keys().hasAll(['ownerId', 'promoCode', 'title', 'targetSegment', 'discountPercent', 'maxDiscountAmount', 'validUntil', 'active', 'usageCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'promoCode', 'title', 'targetSegment', 'discountPercent', 'maxDiscountAmount', 'validUntil', 'active', 'usageCount', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.promoCode is string && data.promoCode.size() >= 3 && data.promoCode.size() <= 30 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.targetSegment is string && data.targetSegment.size() >= 1 && data.targetSegment.size() <= 80 &&
        data.discountPercent is number && data.discountPercent >= 1 && data.discountPercent <= 100 &&
        data.maxDiscountAmount is number && data.maxDiscountAmount >= 0 && data.maxDiscountAmount <= 100000000 &&
        data.validUntil is string && data.validUntil.size() >= 8 && data.validUntil.size() <= 25 &&
        data.active is bool &&
        data.usageCount is number && data.usageCount >= 0 && data.usageCount <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 1. Admins Collection
    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isVerified() && resource.data.uid == request.auth.uid;
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminDoc(incoming()) && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // 2. Users Collection (PII Isolated per User)
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'Staf Operasional' || isAdmin());
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Menu Items Collection
    match /menu_items/{menuId} {
      allow get: if isSignedIn() && isValidId(menuId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(menuId) && isValidMenuItem(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(menuId) && isValidMenuItem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['available', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'packageName', 'description', 'imageUrl', 'sellingPrice', 'costPrice', 'estimatedProfit', 'available', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(menuId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 4. Catering Orders Collection (with Terminal State Locking)
    match /catering_orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(orderId) && isValidCateringOrder(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId) && isValidCateringOrder(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && !(existing().status in ['Selesai', 'Dibatalkan']) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'downPayment', 'remainingBalance', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['customerName', 'whatsapp', 'deliveryDate', 'eventType', 'packageName', 'portions', 'unitPrice', 'discount', 'totalPayment', 'downPayment', 'remainingBalance', 'paymentStatus', 'status', 'notes', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 5. Customers Collection (PII Protected)
    match /customers/{customerId} {
      allow get: if isVerified() && isValidId(customerId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(customerId) && isValidCustomer(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(customerId) && isValidCustomer(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'isPriority', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'locationLat', 'locationLng', 'totalPurchases', 'transactionCount', 'isActive', 'isPriority', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(customerId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 6. Production Batches Collection (with Terminal State Locking)
    match /production_batches/{batchId} {
      allow get: if isSignedIn() && isValidId(batchId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(batchId) && isValidProductionBatch(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(batchId) && isValidProductionBatch(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && !(existing().status in ['Selesai', 'Dibatalkan']) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'documentationNote', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['productionDate', 'menuName', 'targetChannel', 'portions', 'recipeSummary', 'rawMaterialNeed', 'productionCost', 'officerName', 'status', 'documentationNote', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(batchId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 7. Schools Collection
    match /schools/{schoolId} {
      allow get: if isSignedIn() && isValidId(schoolId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(schoolId) && isValidSchoolRecord(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(schoolId) && isValidSchoolRecord(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['partnershipStatus', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['schoolName', 'npsn', 'address', 'principalName', 'contactPhone', 'lat', 'lng', 'studentCount', 'classCount', 'deliverySchedule', 'partnershipStatus', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(schoolId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 8. School Deliveries Collection (Relational Check + Terminal State Locking)
    match /school_deliveries/{deliveryId} {
      allow get: if isSignedIn() && isValidId(deliveryId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(deliveryId) && isValidSchoolDelivery(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/schools/$(incoming().schoolId));
      allow update: if isVerified() && isValidId(deliveryId) && isValidSchoolDelivery(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().schoolId == existing().schoolId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && !(existing().status in ['Selesai', 'Dibatalkan']) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'arrivalTime', 'recipientName', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['deliveryDate', 'schoolName', 'menuPackage', 'portionsDelivered', 'courierName', 'departureTime', 'arrivalTime', 'recipientName', 'status', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(deliveryId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 9. Finance Entries Collection
    match /finance_entries/{entryId} {
      allow get: if isVerified() && isValidId(entryId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(entryId) && isValidFinanceEntry(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(entryId) && isValidFinanceEntry(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['settlementStatus', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['transactionDate', 'referenceCode', 'type', 'category', 'description', 'amount', 'accountMethod', 'settlementStatus', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(entryId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 10. Inventory Items Collection
    match /inventory_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(itemId) && isValidInventoryItem(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(itemId) && isValidInventoryItem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQty', 'lastRestockDate', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['itemCode', 'name', 'category', 'stockQty', 'minStock', 'unit', 'unitCost', 'supplierName', 'lastRestockDate', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(itemId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 11. Promotions Collection
    match /promotions/{promoId} {
      allow get: if isSignedIn() && isValidId(promoId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(promoId) && isValidPromotionItem(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(promoId) && isValidPromotionItem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && (
            incoming().diff(existing()).affectedKeys().hasOnly(['active', 'usageCount', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['promoCode', 'title', 'targetSegment', 'discountPercent', 'maxDiscountAmount', 'validUntil', 'active', 'usageCount', 'updatedAt'])
          ))
        );
      allow delete: if isVerified() && isValidId(promoId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
